DirectoryIndex index.html
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|avif|jpg|jpeg|png|gif|svg|mp4|webm|woff2|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One hop. Internal rewrites use [L] so the browser stays on the same URL.
  RewriteRule ^contact/?$ /pages/contact? [R=301,L]
  RewriteRule ^pages/corporate/?$ /corporate? [R=301,L]
  RewriteRule ^blogs/?$ /blogs/news? [R=301,L]
  RewriteRule ^blogs/ziplining-in-uttarakhand-every-zipline-worth-doing-in-rishikesh/?$ /blogs/news/ziplining-in-uttarakhand-2026-every-zipline-worth-doing? [R=301,L]
  # /blogs/news is also a directory of article HTML. Serve the index file, no redirect.
  RewriteRule ^blogs/news/?$ /blogs/news.html [L]
  RewriteRule ^blogs/([^/]+)/?$ /blogs/news/$1? [R=301,L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>
