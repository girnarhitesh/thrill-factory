DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|avif|jpg|jpeg|png|gif|svg|mp4|webm|woff2|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Old Shopify URLs. The trailing ? drops ?page=N so it is not forwarded.
  RewriteRule ^collections/kids-zone/?$ /kids-zone? [R=301,L]
  RewriteRule ^collections/save-more/?$ /combos? [R=301,L]
  RewriteRule ^collections/rope-bungee-combo/?$ /combos? [R=301,L]
  RewriteCond %{REQUEST_URI} !^/collections/(extreme-adventure|all-adventures|all)/?$
  RewriteRule ^collections/[^/]+/?$ /activities? [R=301,L]
  RewriteCond %{REQUEST_URI} !^/products/(bungee-jumping|giant-swing)/?$
  RewriteRule ^products/[^/]+/?$ /activities? [R=301,L]
  RewriteRule ^pages/corporate/?$ /corporate? [R=301,L]
  RewriteCond %{REQUEST_URI} !^/pages/contact/?$
  RewriteRule ^pages/[^/]+/?$ /? [R=301,L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>
